# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# ── API gateway ──────────────────────────────────────────────────────────────
# HERE + OpenWeather are proxied through our gateway, which injects the real
# provider credentials server-side. The app only holds route-scoped gateway keys.
GATEWAY_BASE_URL=https://api.drohnenwetter.de
GATEWAY_HERE_KEY=
GATEWAY_OWM_KEY=
# Set to "true" only for a local gateway with a self-signed dev certificate.
# GATEWAY_INSECURE_TLS=false

# ── Direct provider credentials (not proxied by the gateway) ─────────────────
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ── Dispatcher API (/api/v1) ─────────────────────────────────────────────────
# Shared secret that zateway sends as X-Internal-Secret when forwarding customer
# API calls. Must match DW_API_SECRET in zateway's .env. Empty = API disabled.
# Generate with: openssl rand -hex 32
DW_API_SECRET=
